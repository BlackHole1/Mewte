# Mewte configuration. Every setting is optional with the default SQLite setup.
# With Docker Compose: copy this file to .env next to compose.yaml.
# Without Docker: export these variables, or copy the file to .env in the directory you start Mewte from.

# --- Docker Compose only -----------------------------------------------------

# Host port the web interface is published on.
#MEWTE_PORT=3000

# Image tag to run, for example 1.2.3. Defaults to latest.
#MEWTE_VERSION=latest

# --- Database ----------------------------------------------------------------

# SQLite (default). Nothing to set: the file is /data/mewte.db in the container,
# or ./data/mewte.db when you run Mewte directly.
#DATABASE_URL=sqlite://./data/mewte.db

# PostgreSQL bundled with compose.yaml. Uncomment all 4 lines.
# Use a password without URL-special characters, for example: openssl rand -hex 24
#COMPOSE_PROFILES=postgres
#DB_PASSWORD=
#DATABASE_URL=postgres://mewte:${DB_PASSWORD}@postgres:5432/mewte
#SECRET_KEY=

# MySQL bundled with compose.yaml. Uncomment all 4 lines.
#COMPOSE_PROFILES=mysql
#DB_PASSWORD=
#DATABASE_URL=mysql://mewte:${DB_PASSWORD}@mysql:3306/mewte
#SECRET_KEY=

# An external server works the same way, without COMPOSE_PROFILES and DB_PASSWORD:
#DATABASE_URL=postgres://user:password@db.example.com:5432/mewte
#DATABASE_URL=mysql://user:password@db.example.com:3306/mewte

# --- Security ----------------------------------------------------------------

# Key that encrypts the stored GitHub tokens, at least 32 characters.
# Generate one with: openssl rand -base64 32
# Required with PostgreSQL or MySQL. With SQLite, Mewte creates one in
# <DATA_DIR>/secret.key on first start if this is empty.
# Losing or changing the key makes the stored tokens unreadable.
#SECRET_KEY=

# If set, the first-run setup page asks for this value before it creates the
# owner account. Use it when the instance is reachable by others before you
# finish the setup.
#SETUP_TOKEN=

# Set to true when Mewte runs behind a reverse proxy that sets
# X-Forwarded-For, X-Forwarded-Host and X-Forwarded-Proto. Leave it off otherwise.
#TRUST_PROXY=false

# Whether the session cookie is marked Secure: auto, true or false.
# auto marks it Secure when the request arrived over HTTPS.
#COOKIE_SECURE=auto

# --- Advanced ----------------------------------------------------------------

# Address and port Mewte listens on.
#HOST=0.0.0.0
#PORT=3000

# Where the SQLite database's secret.key is kept. Fixed to /data in the image.
#DATA_DIR=./data

# YAML file that mirrors the rules: editing it changes the rules, and saving a
# rule in the web interface rewrites it. Its format is described at /llms.txt.
# Check an edited copy before replacing the file: mewte validate-rules <file>
# Default with SQLite: <DATA_DIR>/rules.yaml. With PostgreSQL or MySQL there is no
# file unless you set a path here; use it on one instance only. Set to off to disable.
# With Docker, mount a directory (not the single file) to edit it from the host:
# add "./config:/config" to the volumes of the mewte service and set the path below.
#RULES_FILE=/config/rules.yaml

# GitHub Enterprise Server: the REST API root of your instance.
#GITHUB_API_URL=https://github.example.com/api/v3

# Directory of the built web app. Found automatically in normal setups.
#WEB_DIST=
